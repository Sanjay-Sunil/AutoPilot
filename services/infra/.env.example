# Copy to .env (never commit .env).
DOMAIN=relay.example.com
POSTGRES_PASSWORD=change-me-long-random
# Only needed with `docker compose --profile turn up` (future WebRTC transport).
TURN_SECRET=change-me-long-random
# Add `--external-ip=<public ip>` to the coturn command when behind NAT.
RUST_LOG=info
RATE_LIMIT_PER_MIN=30
RATE_LIMIT_BURST=10
RELAY_IDLE_SECS=120
