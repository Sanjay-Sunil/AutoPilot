{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AutoPilot",
  "version": "0.1.0",
  "identifier": "dev.autopilot.desktop",
  "build": {
    "frontendDist": "../ui/public",
    "beforeBuildCommand": "npx --yes -p typescript@5 tsc -p ui",
    "beforeDevCommand": "npx --yes -p typescript@5 tsc -p ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"]
  }
}
